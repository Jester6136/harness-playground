# Copy to .env and fill in your values.
# Never commit .env to git.

# ── Postgres ──────────────────────────────────────────────────────────────────
USE_POSTGRES=true
POSTGRES_DSN=postgresql://harness:harness@localhost:5432/harness

# ── External LIS Postgres (used by skills/query_lis_db) ──────────────────────
# Read-only role recommended (don't reuse a superuser like `postgres`).
LIS_DB_HOST=192.168.20.10
LIS_DB_PORT=5432
LIS_DB_NAME=geohub_lis
LIS_DB_USER=postgres
LIS_DB_PASSWORD=

# ── DataLens internal-docs retriever (used by tools/search_docs) ─────────────
DATALENS_URL=http://192.168.120.12:37001
DATALENS_CHATBOT_CODE=bags_code
DATALENS_TIMEOUT=60

# ── vLLM (OpenAI-compatible endpoint) ────────────────────────────────────────
VLLM_BASE_URL=http://192.168.120.11:2900/v1
VLLM_MODEL_NAME=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
VLLM_API_KEY=EMPTY

# Reasoning ("thinking"): set true if the served model supports
# chat_template_kwargs.enable_thinking. Reasoning streams as `event: thinking`
# (separate from `event: token`) so the UI can render it as a distinct block.
ENABLE_THINKING=false

# ── Filesystem access ────────────────────────────────────────────────────────
# Grant deepagents' built-in fs tools (ls, read_file, write_file, edit_file,
# glob, grep) real access to the host filesystem via FilesystemPermission.
# SECURITY: only enable inside a sandbox (container, restricted user). Do not
# enable on a shared multi-tenant server.
ALLOW_FILESYSTEM=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/harness.json
